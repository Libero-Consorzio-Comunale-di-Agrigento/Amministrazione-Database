        </preConditions>
        <insert tableName="MODULI">
            <column name="MODULO" value="SI4_UTE" />
            <column name="DESCRIZIONE" value="Sistema Informativo V4 - Applicativo" />
            <column name="PROGETTO" value="SI4" />
