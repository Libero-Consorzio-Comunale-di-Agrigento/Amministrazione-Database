<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.9.xsd">

    <changeSet id="20190515_1815" author="snegroni">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM MODULI WHERE modulo = 'SI4_AMM'</sqlCheck>
        </preConditions>
    <insert tableName="MODULI">
        <column name="MODULO" value="SI4_AMM" />
        <column name="DESCRIZIONE" value="Sistema Informativo V4 - Amministratore" />
        <column name="PROGETTO" value="SI4" />
        <column name="AMMINISTRATORE" value="S" />
    </insert>
    </changeSet>
    <changeSet id="20190515_1820" author="snegroni">
        <preConditions onFail="MARK_RAN">
